/* Gensite studio theme. Colours are tokens like @base@ from gensite/palette.py; change them there.
   The icons folder token is replaced with an absolute path when the sheet is loaded. */

QWidget { background:@base@; color:@text@; font-family:"Segoe UI Variable Text","Segoe UI"; font-size:14px; }
QMainWindow, QDialog { background:@base@; }
QLabel { background:transparent; }
QToolTip { background:@raised@; color:@text@; border:1px solid @border_hi@; border-radius:4px; padding:6px 8px; }

/* Toolbar */
QToolBar { background:@surface@; border:0; border-bottom:1px solid @line@; padding:6px 14px; spacing:2px; }
QToolBar QWidget { background:transparent; }
QLabel#wordmark { color:@text@; font-weight:600; letter-spacing:2px; font-size:13px; }
QLabel#projectLabel { color:@faint@; font-size:12px; }
QToolButton { background:transparent; border:0; border-radius:6px; padding:7px 11px; color:@soft@; }
QToolButton:hover { background:@hover@; color:@text@; }
QToolButton:pressed, QToolButton:checked { background:@pressed@; color:@text@; }
QToolButton:disabled { color:@disabled@; }
QToolButton#publishTool { background:@accent@; color:@on_accent@; font-weight:600; padding:7px 16px; margin-left:6px; }
QToolButton#publishTool:hover { background:@accent_hi@; }
QToolButton#publishTool:pressed { background:@accent_lo@; }
QToolButton#publishTool:disabled { background:@hover@; color:@disabled@; }

/* Type */
QLabel#hero { color:@heading@; font-size:34px; font-weight:500; padding:0 0 2px 0; }
QLabel#dialogTitle { color:@heading@; font-size:22px; font-weight:500; padding:0 0 4px 0; }
QLabel#muted { color:@muted@; font-size:13px; }
QLabel#fieldLabel { color:@soft@; }
QLabel#panelTitle { color:@faint@; font-size:11px; font-weight:600; letter-spacing:1px; padding:16px 4px 6px 1px; }
QLabel#previewTitle { color:@text@; font-size:15px; font-weight:600; }

/* Fields */
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background:@raised@; color:@text@; border:1px solid @border@; border-radius:6px;
    padding:7px 10px; selection-background-color:@accent_line@; selection-color:@heading@; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QPlainTextEdit:hover { border-color:@border_hi@; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color:@accent@; }
QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color:@disabled@; background:@surface@; border-color:@line@; }
QLineEdit#projectName { background:transparent; border:0; border-bottom:1px solid @border@; border-radius:0; font-size:18px; padding:6px 0 10px 0; }
QLineEdit#projectName:focus { border-bottom-color:@accent@; }
QPlainTextEdit#briefComposer { border-color:@border_hi@; border-radius:10px; padding:14px; font-size:15px; }
QPlainTextEdit#briefComposer:focus { border-color:@accent@; }
QPlainTextEdit#codeEditor { border:0; border-radius:0; background:@sunken@; padding:12px; }
QLineEdit#sitePrompt { padding:7px 12px; }

QComboBox { padding:7px 30px 7px 10px; }
QComboBox::drop-down { subcontrol-origin:padding; subcontrol-position:center right; width:26px; border:0; }
QComboBox::down-arrow { image:url(@ICONS@/chevron-down.svg); width:12px; height:12px; }
QComboBox::down-arrow:disabled { image:none; }
QComboBox QAbstractItemView { background:@raised@; color:@text@; border:1px solid @border_hi@; outline:0; padding:4px;
    selection-background-color:@accent_tint@; selection-color:@accent_text@; }

QSpinBox { padding:7px 24px 7px 10px; }
QSpinBox::up-button, QSpinBox::down-button { subcontrol-origin:border; width:22px; border:0; background:transparent; }
QSpinBox::up-button { subcontrol-position:top right; margin:3px 3px 0 0; }
QSpinBox::down-button { subcontrol-position:bottom right; margin:0 3px 3px 0; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background:@pressed@; border-radius:3px; }
QSpinBox::up-arrow { image:url(@ICONS@/chevron-up.svg); width:10px; height:10px; }
QSpinBox::down-arrow { image:url(@ICONS@/chevron-down.svg); width:10px; height:10px; }
QSpinBox::up-arrow:disabled, QSpinBox::down-arrow:disabled { image:none; }

QCheckBox { spacing:10px; color:@text@; background:transparent; }
QCheckBox::indicator { width:16px; height:16px; border:1px solid @border_hi@; border-radius:4px; background:@raised@; }
QCheckBox::indicator:hover { border-color:@accent@; }
QCheckBox::indicator:checked { background:@accent@; border-color:@accent@; image:url(@ICONS@/check.svg); }

/* Buttons */
QPushButton { background:@raised@; color:@text@; border:1px solid @border@; border-radius:6px; padding:8px 14px; }
QPushButton:hover { background:@hover@; border-color:@border_hi@; }
QPushButton:pressed { background:@pressed@; }
QPushButton:focus { border-color:@accent_line@; }
QPushButton:disabled { background:@surface@; color:@disabled@; border-color:@line@; }
QPushButton#primary { background:@accent@; color:@on_accent@; border:1px solid @accent@; font-weight:600; padding:8px 20px; }
QPushButton#primary:hover { background:@accent_hi@; border-color:@accent_hi@; }
QPushButton#primary:pressed { background:@accent_lo@; border-color:@accent_lo@; }
QPushButton#primary:disabled { background:@hover@; border-color:@hover@; color:@disabled@; }
QPushButton#chip { background:transparent; border:1px solid @border@; border-radius:14px; color:@soft@; padding:5px 13px; font-size:12px; }
QPushButton#chip:hover { background:@raised@; color:@text@; border-color:@accent_line@; }
QPushButton#optionsToggle { background:transparent; border:1px solid @border@; border-radius:6px; text-align:left; color:@soft@; padding:8px 12px; }
QPushButton#optionsToggle:hover, QPushButton#optionsToggle:checked { color:@accent_text@; border-color:@accent_line@; }
QPushButton#iconButton { padding:7px 0; min-width:36px; max-width:36px; }

/* Studio surfaces */
QWidget#promptWorkspace { background:transparent; }
QWidget#templatePreview { background:@surface@; border-right:1px solid @line@; }
QWidget#siteBar { background:@surface@; border-bottom:1px solid @line@; }
QWidget#canvasTools { background:@base@; }
QWidget#navigator, QWidget#inspector { background:@surface@; }
QWidget#inspectorForm { background:transparent; }
QWidget#canvasHost { background:@sunken@; }
QWidget#jobPanel { background:@surface@; border-top:1px solid @line@; }

QTreeWidget { background:transparent; border:0; outline:0; padding:2px 0; }
QTreeWidget::item { padding:6px 8px; border:0; border-radius:5px; color:@soft@; }
QTreeWidget::item:hover { background:@hover@; color:@text@; }
QTreeWidget::item:selected { background:@accent_tint@; color:@accent_text@; }
QHeaderView { background:transparent; }
QHeaderView::section { background:transparent; border:0; color:@faint@; padding:16px 4px 6px 4px; font-size:11px; font-weight:600; }

QTabWidget::pane { border:0; border-top:1px solid @line@; }
QTabBar { background:transparent; qproperty-drawBase:0; }
QTabBar::tab { background:transparent; color:@muted@; border:0; border-bottom:2px solid transparent; padding:9px 16px; }
QTabBar::tab:selected { color:@accent_text@; border-bottom-color:@accent@; }
QTabBar::tab:hover:!selected { color:@text@; }

QSplitter::handle { background:@line@; }
QSplitter::handle:horizontal { width:1px; }
QScrollArea { background:transparent; border:0; }
QScrollArea > QWidget > QWidget { background:transparent; }

QScrollBar:vertical { background:transparent; width:10px; margin:2px; }
QScrollBar:horizontal { background:transparent; height:10px; margin:2px; }
QScrollBar::handle:vertical { background:@border@; border-radius:3px; min-height:32px; }
QScrollBar::handle:horizontal { background:@border@; border-radius:3px; min-width:32px; }
QScrollBar::handle:hover { background:@border_hi@; }
QScrollBar::add-line, QScrollBar::sub-line { width:0; height:0; }
QScrollBar::add-page, QScrollBar::sub-page { background:transparent; }

QStatusBar { background:@surface@; border-top:1px solid @line@; color:@faint@; font-size:12px; padding-left:8px; }
QStatusBar::item { border:0; }
QStatusBar QLabel { padding:0 8px; }
QProgressBar { border:0; background:@hover@; max-height:3px; border-radius:1px; }
QProgressBar::chunk { background:@accent@; border-radius:1px; }

QDialogButtonBox QPushButton { min-width:84px; }
QMessageBox QLabel { color:@text@; }

/* Support window */
QWidget#supportFooter { border-top:1px solid @line@; }
QLabel#supportNote { color:@muted@; font-size:12px; }
QLabel#supportStatus { color:@muted@; font-size:13px; }
