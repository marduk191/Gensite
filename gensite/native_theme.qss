/* Gensite studio theme. Quiet dark chrome, one warm accent.
   Palette: app #111317 · panel #16191e · field #1c1f26 · line #262a32 / #343944
            text #e7e8eb · secondary #a3a8b2 · tertiary #737985 · accent #d8a47f
   @ICONS@ is replaced with the absolute icons folder when the sheet is loaded. */

QWidget { background:#111317; color:#e7e8eb; font-family:"Segoe UI Variable Text","Segoe UI"; font-size:14px; }
QMainWindow, QDialog { background:#111317; }
QLabel { background:transparent; }
QToolTip { background:#1c1f26; color:#e7e8eb; border:1px solid #343944; border-radius:4px; padding:6px 8px; }

/* Toolbar */
QToolBar { background:#16191e; border:0; border-bottom:1px solid #262a32; padding:6px 14px; spacing:2px; }
QToolBar QWidget { background:transparent; }
QLabel#wordmark { color:#e7e8eb; font-weight:600; letter-spacing:2px; font-size:13px; }
QLabel#projectLabel { color:#737985; font-size:12px; }
QToolButton { background:transparent; border:0; border-radius:6px; padding:7px 11px; color:#c3c7cf; }
QToolButton:hover { background:#21252d; color:#ffffff; }
QToolButton:pressed, QToolButton:checked { background:#262a33; color:#ffffff; }
QToolButton:disabled { color:#5b606b; }
QToolButton#publishTool { background:#d8a47f; color:#1a1512; font-weight:600; padding:7px 16px; margin-left:6px; }
QToolButton#publishTool:hover { background:#e6b48f; }
QToolButton#publishTool:pressed { background:#c38f6b; }
QToolButton#publishTool:disabled { background:#23262d; color:#5b606b; }

/* Type */
QLabel#hero { color:#f1efea; font-size:34px; font-weight:500; padding:0 0 2px 0; }
QLabel#dialogTitle { color:#f1efea; font-size:22px; font-weight:500; padding:0 0 4px 0; }
QLabel#muted { color:#8d939e; font-size:13px; }
QLabel#fieldLabel { color:#a3a8b2; }
QLabel#panelTitle { color:#737985; font-size:11px; font-weight:600; letter-spacing:1px; padding:16px 4px 6px 1px; }
QLabel#previewTitle { color:#e7e8eb; font-size:15px; font-weight:600; }

/* Fields */
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background:#1c1f26; color:#e7e8eb; border:1px solid #2c3038; border-radius:6px;
    padding:7px 10px; selection-background-color:#6a5446; selection-color:#ffffff; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QPlainTextEdit:hover { border-color:#3d424d; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color:#d8a47f; }
QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color:#5b606b; background:#16191e; border-color:#22252c; }
QLineEdit#projectName { background:transparent; border:0; border-bottom:1px solid #2c3038; border-radius:0; font-size:18px; padding:6px 0 10px 0; }
QLineEdit#projectName:focus { border-bottom-color:#d8a47f; }
QPlainTextEdit#briefComposer { border-color:#343944; border-radius:10px; padding:14px; font-size:15px; }
QPlainTextEdit#briefComposer:focus { border-color:#d8a47f; }
QLineEdit#sitePrompt { padding:7px 12px; }

QComboBox { padding:7px 30px 7px 10px; }
QComboBox::drop-down { subcontrol-origin:padding; subcontrol-position:center right; width:26px; border:0; }
QComboBox::down-arrow { image:url(@ICONS@/chevron-down.svg); width:12px; height:12px; }
QComboBox::down-arrow:disabled { image:none; }
QComboBox QAbstractItemView { background:#1c1f26; color:#e7e8eb; border:1px solid #343944; outline:0; padding:4px;
    selection-background-color:#2c2622; selection-color:#f0c7a7; }

QSpinBox { padding:7px 24px 7px 10px; }
QSpinBox::up-button, QSpinBox::down-button { subcontrol-origin:border; width:22px; border:0; background:transparent; }
QSpinBox::up-button { subcontrol-position:top right; margin:3px 3px 0 0; }
QSpinBox::down-button { subcontrol-position:bottom right; margin:0 3px 3px 0; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background:#262a33; border-radius:3px; }
QSpinBox::up-arrow { image:url(@ICONS@/chevron-up.svg); width:10px; height:10px; }
QSpinBox::down-arrow { image:url(@ICONS@/chevron-down.svg); width:10px; height:10px; }
QSpinBox::up-arrow:disabled, QSpinBox::down-arrow:disabled { image:none; }

QCheckBox { spacing:10px; color:#d6d9de; background:transparent; }
QCheckBox::indicator { width:16px; height:16px; border:1px solid #3d424d; border-radius:4px; background:#1c1f26; }
QCheckBox::indicator:hover { border-color:#d8a47f; }
QCheckBox::indicator:checked { background:#d8a47f; border-color:#d8a47f; image:url(@ICONS@/check.svg); }

/* Buttons */
QPushButton { background:#1f232a; color:#d6d9de; border:1px solid #2f343d; border-radius:6px; padding:8px 14px; }
QPushButton:hover { background:#262a32; border-color:#434955; color:#ffffff; }
QPushButton:pressed { background:#2c3039; }
QPushButton:focus { border-color:#7a6252; }
QPushButton:disabled { background:#191b20; color:#5b606b; border-color:#23262c; }
QPushButton#primary { background:#d8a47f; color:#1a1512; border:1px solid #d8a47f; font-weight:600; padding:8px 20px; }
QPushButton#primary:hover { background:#e6b48f; border-color:#e6b48f; }
QPushButton#primary:pressed { background:#c38f6b; border-color:#c38f6b; }
QPushButton#primary:disabled { background:#23262d; border-color:#23262d; color:#5b606b; }
QPushButton#chip { background:transparent; border:1px solid #2c3038; border-radius:14px; color:#a3a8b2; padding:5px 13px; font-size:12px; }
QPushButton#chip:hover { background:#1c1f26; color:#e7e8eb; border-color:#6a5446; }
QPushButton#optionsToggle { background:transparent; border:1px solid #2c3038; border-radius:6px; text-align:left; color:#c3c7cf; padding:8px 12px; }
QPushButton#optionsToggle:hover, QPushButton#optionsToggle:checked { color:#f0c7a7; border-color:#4a3d34; }
QPushButton#donate { background:transparent; border:0; color:#8d939e; padding:2px 0; font-size:12px; text-decoration:underline; }
QPushButton#donate:hover { color:#f0c7a7; }
QPushButton#iconButton { padding:7px 0; min-width:36px; max-width:36px; }

/* Studio surfaces */
QWidget#promptWorkspace { background:transparent; }
QWidget#templatePreview { background:#16191e; border-right:1px solid #262a32; }
QWidget#siteBar { background:#16191e; border-bottom:1px solid #262a32; }
QWidget#canvasTools { background:#111317; }
QWidget#navigator, QWidget#inspector { background:#16191e; }
QWidget#inspectorForm { background:transparent; }
QWidget#canvasHost { background:#0d0f12; }
QWidget#jobPanel { background:#16191e; border-top:1px solid #262a32; }

QTreeWidget { background:transparent; border:0; outline:0; padding:2px 0; }
QTreeWidget::item { padding:6px 8px; border:0; border-radius:5px; color:#c3c7cf; }
QTreeWidget::item:hover { background:#1f232a; color:#ffffff; }
QTreeWidget::item:selected { background:#2a2420; color:#f0c7a7; }
QHeaderView { background:transparent; }
QHeaderView::section { background:transparent; border:0; color:#737985; padding:16px 4px 6px 4px; font-size:11px; font-weight:600; }

QTabWidget::pane { border:0; border-top:1px solid #262a32; }
QTabBar { background:transparent; qproperty-drawBase:0; }
QTabBar::tab { background:transparent; color:#8d939e; border:0; border-bottom:2px solid transparent; padding:9px 16px; }
QTabBar::tab:selected { color:#f0c7a7; border-bottom-color:#d8a47f; }
QTabBar::tab:hover:!selected { color:#e7e8eb; }

QSplitter::handle { background:#262a32; }
QSplitter::handle:horizontal { width:1px; }
QScrollArea { background:transparent; border:0; }
QScrollArea > QWidget > QWidget { background:transparent; }

QScrollBar:vertical { background:transparent; width:10px; margin:2px; }
QScrollBar:horizontal { background:transparent; height:10px; margin:2px; }
QScrollBar::handle:vertical { background:#2f343d; border-radius:3px; min-height:32px; }
QScrollBar::handle:horizontal { background:#2f343d; border-radius:3px; min-width:32px; }
QScrollBar::handle:hover { background:#4a505b; }
QScrollBar::add-line, QScrollBar::sub-line { width:0; height:0; }
QScrollBar::add-page, QScrollBar::sub-page { background:transparent; }

QStatusBar { background:#16191e; border-top:1px solid #262a32; color:#737985; font-size:12px; padding-left:8px; }
QStatusBar::item { border:0; }
QStatusBar QLabel { padding:0 8px; }
QProgressBar { border:0; background:#23262d; max-height:3px; border-radius:1px; }
QProgressBar::chunk { background:#d8a47f; border-radius:1px; }

QDialogButtonBox QPushButton { min-width:84px; }
QMessageBox QLabel { color:#e7e8eb; }
